{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zrt-amocrm-lead-receiver",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "adv.zrt-school.ru/statistics/api*",
      "zone_name": "zrt-school.ru"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://adv.zrt-school.ru",
    "ACCESS_AUD": "ecb0a2a3440be86430aef7342179e644d05f8149fe7139a25160afd11213ff71",
    "ACCESS_ALLOWED_EMAIL": "magniffique@gmail.com",
    "ACCESS_TEAM_DOMAIN": "holy-base-80ee.cloudflareaccess.com",
    "AMO_BASE_URL": "https://zrtschool.amocrm.ru",
    "AMO_PIPELINE_ID": "7437290",
    "AMO_UNSORTED_STATUS_ID": "61762778",
    "YANDEX_METRIKA_COUNTER_ID": "32428555",
    "YANDEX_METRIKA_OFFLINE_GOAL": "lead_created_crm"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zrt-lead-journal",
      "database_id": "982a4cdb-e441-4659-b3c7-c03a9d1e57fc",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
